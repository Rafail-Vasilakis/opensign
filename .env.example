# OpenSign Configuration

PORT=3000
NODE_ENV=production

# Base URL for signing links sent in invitation emails (e.g. https://sign.yourdomain.com)
BASE_URL=http://localhost:3000

# ==============================================================
# SMTP Email Configuration (Optional)
# If left blank, emails are logged to the console (zero setup needed)
# Works with Gmail, Sendgrid, Resend, Amazon SES, Mailgun, or any SMTP server
# ==============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="OpenSign" <no-reply@yourdomain.com>
